{
  "name": "@shardis/cli",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "shardis-cli: a WebSocket client for talking to a shardis node or cluster.",
  "bin": {
    "shardis-cli": "dist/shardis-cli.js"
  },
  "scripts": {
    "dev": "tsx src/shardis-cli.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/shardis-cli.js",
    "test": "vitest run",
    "lint": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.0",
    "@types/ws": "^8.5.13",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vite": "^7.0.0",
    "vitest": "^5.0.1"
  }
}

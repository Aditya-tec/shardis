# Per-node configuration. Copy to .env and adjust per environment.

# Unique id for this node - used in logs, hash ring, promotion tie-breaks
NODE_ID=node-a1

# leader | follower at boot (can change at runtime after failover)
ROLE=leader

# Which shard this node belongs to
SHARD_ID=shard-a

# Path to the cluster topology file to load
CLUSTER_CONFIG_PATH=./cluster.config.local.json

# Port the node listens on for WS + HTTP (/healthz, /metrics)
PORT=7000

# Memory cap (MB) before LRU eviction kicks in
MAXMEMORY_MB=64

# How often the active TTL sweep runs (ms)
TTL_SWEEP_INTERVAL_MS=1000

# How often a full snapshot + AOF compaction runs (ms)
SNAPSHOT_INTERVAL_MS=60000

# Leader heartbeat cadence and the timeout that triggers failover (ms)
HEARTBEAT_INTERVAL_MS=1000
HEARTBEAT_TIMEOUT_MS=3000

# Per-connection request cap (requests/sec)
RATE_LIMIT_RPS=50

# Input bounds
MAX_KEY_BYTES=1024
MAX_VALUE_BYTES=65536

# true only on the Render deployment - turns on write-protection
PUBLIC_DEMO=false

# Required write key when PUBLIC_DEMO=true (set as a Render env var, never committed)
DEMO_WRITE_KEY=
